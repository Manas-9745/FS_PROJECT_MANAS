  "item": [
    {
      "name": "1. POST - Register User (Step 15 Test 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created or 400 (if already exists)', function () {",
              "    pm.expect([201, 400]).to.include(pm.response.code);",
              "});",
              "var jsonData = pm.response.json();",
              "if (pm.response.code === 201) {",
              "    pm.test('User registered successfully message', function () {",
              "        pm.expect(jsonData.message).to.eql('User registered successfully');",
              "        pm.expect(jsonData.userId).to.exist;",
              "    });",
              "    pm.collectionVariables.set('user_id', jsonData.userId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"student\",\n  \"email\": \"student@gmail.com\",\n  \"password\": \"student123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/register",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Step 15 Test 1: Register a new user with bcrypt password hashing."
      }
    },
    {
      "name": "2. POST - Login User (Step 15 Test 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Login successful and JWT token returned', function () {",
              "    pm.expect(jsonData.message).to.eql('Login successful');",
              "    pm.expect(jsonData.token).to.exist;",
              "});",
              "pm.collectionVariables.set('jwt_token', jsonData.token);",
              "console.log('Saved JWT Token:', jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@gmail.com\",\n  \"password\": \"student123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/login",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "login"]
        },
        "description": "Step 15 Test 2: Login with email and password to receive JWT token."
      }
    },
    {
      "name": "3. GET - Access Protected Profile (Step 15 Test 3)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test('Profile returns user details without password', function () {",
              "    pm.expect(jsonData.email).to.eql('student@gmail.com');",
              "    pm.expect(jsonData.role).to.eql('user');",
              "    pm.expect(jsonData.password).to.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwt_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/profile",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "profile"]
        },
        "description": "Step 15 Test 3: Access protected profile route using Bearer JWT token."
      }
    },
